<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>CDBox.RealEstate</AssemblyName>
    <RootNamespace>CDBox.RealEstate</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <InformationalVersion>0.2.0</InformationalVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>
    <AutoCADManagedDir Condition="'$(AutoCADManagedDir)' == ''">D:\Program Files\Autodesk\AutoCAD 2023</AutoCADManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NPOI" Version="2.8.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AcMgd">
      <HintPath>$(AutoCADManagedDir)\AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AutoCADManagedDir)\AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcCoreMgd">
      <HintPath>$(AutoCADManagedDir)\AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CDBox.Shared\CDBox.Shared.csproj" />
  </ItemGroup>

  <Target Name="ValidateAutoCADManagedReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error
      Condition="!Exists('$(AutoCADManagedDir)\AcMgd.dll') Or !Exists('$(AutoCADManagedDir)\AcDbMgd.dll') Or !Exists('$(AutoCADManagedDir)\AcCoreMgd.dll')"
      Text="未在 $(AutoCADManagedDir) 找到 AutoCAD 2023 托管程序集。请通过 /p:AutoCADManagedDir=&quot;实际目录&quot; 指定路径。" />
  </Target>
</Project>
