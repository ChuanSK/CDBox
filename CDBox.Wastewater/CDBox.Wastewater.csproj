<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>CDBox.Wastewater</AssemblyName>
    <RootNamespace>CDBox.Wastewater</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>0.8.0</Version>
    <AssemblyVersion>0.8.0.0</AssemblyVersion>
    <FileVersion>0.8.0.0</FileVersion>
    <InformationalVersion>0.8.0</InformationalVersion>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>
    <AutoCADManagedDir Condition="'$(AutoCADManagedDir)' == ''">D:\Program Files\Autodesk\AutoCAD 2023</AutoCADManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NPOI" Version="2.8.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\CDBox_Integrated\Templates\工程量计算表模板.xls"
             Link="Templates\工程量计算表模板.xls">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Templates\工程量计算表模板.xls</TargetPath>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CDBox.Shared\CDBox.Shared.csproj" />
    <Reference Include="AcMgd">
      <HintPath>$(AutoCADManagedDir)\AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AutoCADManagedDir)\AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcCoreMgd">
      <HintPath>$(AutoCADManagedDir)\AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Drawing" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\CDBox_Integrated\Modules\SurfaceAreaAnnotation\SurfaceAreaAnnotationModels.cs"
             Link="Cad\SurfaceAreaAnnotation\SurfaceAreaAnnotationModels.cs" />
    <Compile Include="..\CDBox_Integrated\Modules\SurfaceAreaAnnotation\SurfaceAreaAnnotationSettingsStore.cs"
             Link="Cad\SurfaceAreaAnnotation\SurfaceAreaAnnotationSettingsStore.cs" />
    <Compile Include="..\CDBox_Integrated\Modules\SurfaceAreaAnnotation\SurfaceAreaAnnotationMetadataService.cs"
             Link="Cad\SurfaceAreaAnnotation\SurfaceAreaAnnotationMetadataService.cs" />
    <Compile Include="..\CDBox_Integrated\Modules\SurfaceAreaAnnotation\SurfaceAreaAnnotationService.cs"
             Link="Cad\SurfaceAreaAnnotation\SurfaceAreaAnnotationService.cs" />
    <Compile Include="..\CDBox_Integrated\Core\Cad\CadDrawService.cs"
             Link="Infrastructure\Cad\CadDrawService.cs" />
    <Compile Include="..\CDBox_Integrated\Core\Cad\CadLayerService.cs"
             Link="Infrastructure\Cad\CadLayerService.cs" />
    <Compile Include="..\CDBox_Integrated\UI\Controls\CDBoxColorPicker.cs"
             Link="Infrastructure\UI\CDBoxColorPicker.cs" />
    <Compile Include="..\CDBox_Integrated\Modules\AnnotationHud\AnnotationHudWindowBase.cs"
             Link="Infrastructure\UI\AnnotationHudWindowBase.cs" />
    <Compile Include="..\CDBox_Integrated\Modules\AnnotationHud\AnnotationHudPopupAnimationController.cs"
             Link="Infrastructure\UI\AnnotationHudPopupAnimationController.cs" />
    <Compile Include="..\CDBox_Integrated\Core\Colors\CDBoxColorService.cs"
             Link="Infrastructure\Colors\CDBoxColorService.cs" />
  </ItemGroup>

  <Target Name="ValidateAutoCADManagedDir" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(AutoCADManagedDir)\AcMgd.dll')"
           Text="找不到 AutoCAD 托管程序集：$(AutoCADManagedDir)\AcMgd.dll。请通过 /p:AutoCADManagedDir=... 指定 CAD 安装目录。" />
  </Target>
</Project>
