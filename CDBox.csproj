<!-- CDBoxNet.AutoCAD2023.csproj -->
<!-- ?? AutoCAD 2023 / CASS11 ????? .NET Framework 4.8 ????? -->
<!-- ?????????? /p:AutoCADManagedDir="..." ??? -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>CDBox</RootNamespace>
    <AssemblyName>CDBox</AssemblyName>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>3.4.1</Version>

    <AssemblyVersion>3.4.1.0</AssemblyVersion>
    <FileVersion>3.4.1.0</FileVersion>
    <InformationalVersion>3.4.1</InformationalVersion>

    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <CDBoxVersionCode>30401</CDBoxVersionCode>

    <CDBoxReleaseIdentity>CDBox-Studio-Preview-3.4.1</CDBoxReleaseIdentity>
    <CDBoxReleaseTitle>CDBox Studio Preview 3.4.1</CDBoxReleaseTitle>
    <CDBoxPackageFileName>CDBox.Studio.Preview.3.4.1.zip</CDBoxPackageFileName>
    <CDBoxAppVersion>3.4.1</CDBoxAppVersion>

    <CDBoxUpdateChannel>studio-preview</CDBoxUpdateChannel>
    <UseWindowsForms>true</UseWindowsForms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	<AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>
    <AutoCADManagedDir Condition="'$(AutoCADManagedDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2023</AutoCADManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="CDBoxVersionCode" Value="$(CDBoxVersionCode)" />
    <AssemblyMetadata Include="CDBoxReleaseIdentity" Value="$(CDBoxReleaseIdentity)" />
    <AssemblyMetadata Include="CDBoxReleaseTitle" Value="$(CDBoxReleaseTitle)" />
    <AssemblyMetadata Include="CDBoxUpdateChannel" Value="$(CDBoxUpdateChannel)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AcMgd">
      <HintPath>$(AutoCADManagedDir)\AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AutoCADManagedDir)\AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcCoreMgd">
      <HintPath>$(AutoCADManagedDir)\AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NPOI" Version="2.8.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(NuGetPackageRoot)skiasharp\3.119.2\lib\net462\SkiaSharp.dll"
             Link="SkiaSharp.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>SkiaSharp.dll</TargetPath>
    </Content>
    <Content Include="CDBox_Integrated\Templates\????????.xls">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Templates\????????.xls</TargetPath>
    </Content>
    <Content Include="CDBox_Integrated\Config\CDBoxColors.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Config\CDBoxColors.json</TargetPath>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="CDBox_Integrated\UI\Studio\Web\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Studio\Web\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
    <Content Include="CDBox_Integrated\UI\Studio\dist\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Studio\dist\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
    <Content Include="CDBox_Integrated\Web\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Web\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
    <Content Include="CDBox_Integrated\wwwroot\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="CDBoxUpdater\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <ProjectReference Include="CDBoxUpdater\CDBoxUpdater.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyCDBoxUpdaterOutput" AfterTargets="Build">
    <ItemGroup>
      <_CDBoxUpdaterFiles Include="$(MSBuildProjectDirectory)\CDBoxUpdater\bin\$(Configuration)\net48\CDBoxUpdater.*" />
    </ItemGroup>
    <MakeDir Directories="$(TargetDir)Updater" />
    <Copy SourceFiles="@(_CDBoxUpdaterFiles)" DestinationFolder="$(TargetDir)Updater" SkipUnchangedFiles="true" Condition="'@(_CDBoxUpdaterFiles)' != ''" />
  </Target>

  <Target Name="ValidateAutoCADManagedReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error
      Condition="!Exists('$(AutoCADManagedDir)\AcMgd.dll') Or !Exists('$(AutoCADManagedDir)\AcDbMgd.dll') Or !Exists('$(AutoCADManagedDir)\AcCoreMgd.dll')"
      Text="?? $(AutoCADManagedDir) ?? AutoCAD 2023 ????????? AutoCAD 2023???? /p:AutoCADManagedDir=&quot;????&quot; ?????" />

  </Target>
</Project>
