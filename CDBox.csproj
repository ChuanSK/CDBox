<!-- CDBoxNet.AutoCAD2023.csproj -->
<!-- 面向 AutoCAD 2023 / CASS11 宿主环境的 .NET Framework 4.8 项目模板。 -->
<!-- 非默认安装位置可通过 /p:AutoCADManagedDir="..." 覆盖。 -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>CDBox</RootNamespace>
    <AssemblyName>CDBox</AssemblyName>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>5.1.9</Version>

    <AssemblyVersion>5.1.9.0</AssemblyVersion>
    <FileVersion>5.1.9.0</FileVersion>
    <InformationalVersion>5.1.9</InformationalVersion>

    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <CDBoxVersionCode>50109</CDBoxVersionCode>

    <CDBoxReleaseIdentity>CDBox-Studio-Preview-5.1.9</CDBoxReleaseIdentity>
    <CDBoxReleaseTitle>CDBox Studio Preview 5.1.9</CDBoxReleaseTitle>
    <CDBoxInstallerFileName>CDBoxInstaller-5.1.9.exe</CDBoxInstallerFileName>
    <CDBoxAppVersion>5.1.9</CDBoxAppVersion>

    <CDBoxUpdateChannel Condition="'$(CDBoxUpdateChannel)' == ''">preview</CDBoxUpdateChannel>
    <UseWindowsForms>true</UseWindowsForms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	<AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>
    <AutoCADManagedDir Condition="'$(AutoCADManagedDir)' == ''">D:\Program Files\Autodesk\AutoCAD 2023</AutoCADManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="CDBox_Integrated\UI\WorkbenchAssets\*.*" LogicalName="CDBox.Workbench.%(Filename)%(Extension)" />
    <AssemblyMetadata Include="CDBoxVersionCode" Value="$(CDBoxVersionCode)" />
    <AssemblyMetadata Include="CDBoxReleaseIdentity" Value="$(CDBoxReleaseIdentity)" />
    <AssemblyMetadata Include="CDBoxReleaseTitle" Value="$(CDBoxReleaseTitle)" />
    <AssemblyMetadata Include="CDBoxUpdateChannel" Value="$(CDBoxUpdateChannel)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AcMgd">
      <HintPath>$(AutoCADManagedDir)\AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AutoCADManagedDir)\AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcCoreMgd">
      <HintPath>$(AutoCADManagedDir)\AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Web" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NPOI" Version="2.8.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(NuGetPackageRoot)skiasharp\3.119.2\lib\net462\SkiaSharp.dll"
             Link="SkiaSharp.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>SkiaSharp.dll</TargetPath>
    </Content>
    <Content Include="CDBox_Integrated\Templates\权籍调查表.xls">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Templates\权籍调查表.xls</TargetPath>
    </Content>
    <Content Include="CDBox_Integrated\Templates\地籍调查表.docx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Templates\地籍调查表.docx</TargetPath>
    </Content>
    <Content Include="CDBox_Integrated\Templates\房产.docx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Templates\房产.docx</TargetPath>
    </Content>
    <Content Include="CDBox_Integrated\Templates\四张检查表.xls">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Templates\四张检查表.xls</TargetPath>
    </Content>
    <Content Include="CDBox_Integrated\Config\CDBoxColors.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Config\CDBoxColors.json</TargetPath>
    </Content>
    <Content Include="CDBox_Integrated\Install\components.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>components.json</TargetPath>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="CDBox_Integrated\UI\Studio\Web\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Studio\Web\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
    <Content Include="CDBox_Integrated\UI\Studio\dist\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Studio\dist\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
    <Content Include="CDBox_Integrated\Web\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Web\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
    <Content Include="CDBox_Integrated\wwwroot\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="CDBox.Shared\**\*.cs" />
    <Compile Remove="CDBox.Common\**\*.cs" />
    <Compile Remove="CDBox.Wastewater\**\*.cs" />
    <Compile Remove="CDBox.RealEstate\**\*.cs" />
    <Compile Remove="CDBox_Integrated\Modules\SurfaceAreaAnnotation\**\*.cs" />
    <Compile Remove="CDBoxInstaller\**\*.cs" />
    <Compile Remove="CDBox.ReleaseTool\**\*.cs" />
    <Compile Remove="CDBoxUpdater\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <ProjectReference Include="CDBox.Shared\CDBox.Shared.csproj" />
    <ProjectReference Include="CDBox.Common\CDBox.Common.csproj" Private="false" />
    <ProjectReference Include="CDBox.Wastewater\CDBox.Wastewater.csproj" Private="false" Aliases="WastewaterBusiness" />
    <ProjectReference Include="CDBox.RealEstate\CDBox.RealEstate.csproj" Private="false" />
  </ItemGroup>

  <Target Name="CopyCommonModuleOutput" AfterTargets="Build">
    <ItemGroup>
      <_CDBoxCommonFiles Include="$(MSBuildProjectDirectory)\CDBox.Common\bin\$(Configuration)\net48\CDBox.Common.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_CDBoxCommonFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="'@(_CDBoxCommonFiles)' != ''" />
  </Target>

  <Target Name="CopyWastewaterModuleOutput" AfterTargets="Build">
    <ItemGroup>
      <_CDBoxWastewaterFiles Include="$(MSBuildProjectDirectory)\CDBox.Wastewater\bin\$(Configuration)\net48\CDBox.Wastewater.*" />
      <_CDBoxWastewaterTemplates Include="$(MSBuildProjectDirectory)\CDBox.Wastewater\bin\$(Configuration)\net48\Templates\工程量计算表模板.xls" />
    </ItemGroup>
    <Copy SourceFiles="@(_CDBoxWastewaterFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="'@(_CDBoxWastewaterFiles)' != ''" />
    <MakeDir Directories="$(TargetDir)Templates" Condition="'@(_CDBoxWastewaterTemplates)' != ''" />
    <Copy SourceFiles="@(_CDBoxWastewaterTemplates)" DestinationFolder="$(TargetDir)Templates" SkipUnchangedFiles="true" Condition="'@(_CDBoxWastewaterTemplates)' != ''" />
  </Target>

  <Target Name="CopyRealEstateModuleOutput" AfterTargets="Build">
    <ItemGroup>
      <_CDBoxRealEstateFiles Include="$(MSBuildProjectDirectory)\CDBox.RealEstate\bin\$(Configuration)\net48\CDBox.RealEstate.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_CDBoxRealEstateFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="'@(_CDBoxRealEstateFiles)' != ''" />
  </Target>

  <Target Name="RemoveLegacyUpdateArtifacts" BeforeTargets="Build">
    <RemoveDir Directories="$(TargetDir)Updater;$(TargetDir)Installer" />
  </Target>

  <Target Name="ValidateAutoCADManagedReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error
      Condition="!Exists('$(AutoCADManagedDir)\AcMgd.dll') Or !Exists('$(AutoCADManagedDir)\AcDbMgd.dll') Or !Exists('$(AutoCADManagedDir)\AcCoreMgd.dll')"
      Text="未在 $(AutoCADManagedDir) 找到 AutoCAD 2023 托管程序集。请安装 AutoCAD 2023，或通过 /p:AutoCADManagedDir=&quot;实际目录&quot; 指定路径。" />

  </Target>
</Project>
